#!/bin/sh

# Keep the fork's settings, saves, NAND, and SDMC separate from official Azahar.
data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_DATA_HOME="${data_home%/}/azahar-yw"
export XDG_CONFIG_HOME="${config_home%/}/azahar-yw"
export XDG_CACHE_HOME="${cache_home%/}/azahar-yw"

exec /usr/lib/azahar-yw/azahar "$@"
